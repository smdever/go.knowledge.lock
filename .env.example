# Copy to .env.local for local development. In Vercel, set these under Project Settings > Environment Variables.

# Postgres connection string (Supabase transaction pooler or Neon). POSTGRES_URL is also accepted.
# Leave empty locally to use an in-memory store.
DATABASE_URL=

# Model provider keys. Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Lock authority signing key. Generate with: node scripts/generate-authority-key.mjs
KL_AUTHORITY_PRIVATE_KEY=
KL_AUTHORITY_PUBLIC_KEY=

# Optional: model IDs (check they are current with: node --env-file=.env.local scripts/check-models.mjs)
KL_ANTHROPIC_MODEL=claude-sonnet-5-5
KL_OPENAI_MODEL=gpt-5.6-terra
KL_GOOGLE_MODEL=gemini-3.5-flash
# Which provider answers "Ask the agent" and the drift check
KL_AGENT_PROVIDER=anthropic

# Optional: usage limits on model calls
KL_IP_HOURLY_LIMIT=40
KL_DAILY_LIMIT=800

# Optional: link back to the main site
NEXT_PUBLIC_SITE_URL=https://guidedorchestration.com

# Local testing only: fake model responses (ignored in production builds)
# KL_FAKE_MODELS=1
